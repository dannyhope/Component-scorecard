<!DOCTYPE html>
<html>
  <head>
    <style>
      /* Base layout */
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding: 4px 4px 40px 4px;
        background-color: white;
        font-size: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      /* Search filter and settings section */
      .filter-section {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .filter-input {
        display: none;
      }

      .settings-button {
        width: 28px;
        height: 28px;
        padding: 6px;
        border: none;
        background: none;
        cursor: pointer;
        color: #888;
        border-radius: 999px;
      }

      .settings-button:hover {
        background-color: rgba(0, 0, 0, 0.06);
      }

      /* Component count section */
      .component-count-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        padding: 8px;
        border-top: 1px solid #E6E7E8;
        z-index: 100;
      }

      .build-number {
        color: #888;
        font-size: 10px;
        position: absolute;
        bottom: 8px;
        left: 50%;
        transform: translateX(-50%);
      }

      .component-count {
        color: #666;
        font-size: 14px;
      }

      .settings-button svg {
        width: 16px;
        height: 16px;
      }

      /* Component list items */
      .component-section {
        margin-bottom: 4px;
        padding: 2px 0;
        border-radius: 4px;
        transition: background-color 0.2s ease;
      }
      .component-section.selected {
        background-color: #E8F4FE !important;
      }

      /* Component title bar */
      .component-title {
        font-size: 14px;
        font-weight: normal;
        margin-bottom: 4px;
        cursor: pointer; /* Entire title is clickable */
        color: #9B51E0;
        display: flex;
        align-items: center;
        height: 18px;
        gap: 4px;
        padding-right: 8px;
      }

      .component-section.selected .component-title {
        color: #7C3DDD;
        font-weight: bold;
      }

      /* Expand/collapse arrow */
      .component-expand {
        cursor: pointer;
        padding: 4px;
        color: #888;
        font-size: 8px;
        width: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Category titles */
      .category-title {
        font-weight: 400;
        margin-top: 8px;
        margin-bottom: 8px;
        color: #767676;
        font-size: 14px;
      }

      .checkbox-timestamp, .last-modified {
        color: #888;
        font-size: 11px;
        margin-left: 8px;
      }

      .modified-indicator {
        display: none; /* Hide the indicator but keep the style for future use */
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: #FF4058;
        flex-shrink: 0;
        margin-right: 4px;
      }

      .last-modified {
        display: none; /* Hide the date but keep tracking it */
        font-weight: normal;
      }

      .checkbox-label {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 6px;
        margin: 0 -12px;
        border-radius: 4px;
        cursor: default;



      }

      .checkbox-label:hover {
        background-color: #C4E2FC;
      }

      /* Custom rules section */
      .custom-heading {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 10px;
        color: black;
      }

      /* Score colors */
      .score-red {
        color: red;      /* 0-33% complete */
      }
      .score-amber {
        color: orange;   /* 34-66% complete */
      }
      .score-green {
        color: green;    /* 67-100% complete */
      }

      /* Checkbox groups and items */
      /* Component rules container */
      .component-rules {
        margin-left: 16px;      /* Indent from title */
        margin-bottom: 8px;      /* Space between categories */
      }
      
      /* Individual category groups */
      .category-group {
        margin-left: 16px;      /* Indent from title */
        margin-bottom: 8px;      /* Space between categories */
      }
      /* Hidden elements */
      .component-rules.hidden {
        display: none;
      }
      .checkbox-group label {
        font-size: 14px;
        line-height: 16px;       /* Tight line spacing within items */
        display: flex;
        align-items: flex-start;  /* Align checkbox with first line */
        gap: 6px;               /* Space between checkbox and text */
        margin-bottom: 6px;    /* Space between items */
      }
      .checkbox-group label:last-child {
        margin-bottom: 0;        /* Remove extra space after last item */
      }
      
      .checkbox-group input[type="checkbox"] {
        margin: 0;
      }

      /* Settings dropdown styles */
      .settings-dropdown {
        position: fixed;
        bottom: 48px;
        right: 8px;
        margin-top: 4px;
        background: white;
        border: 1px solid #C7D0D4;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        min-width: 220px;
        display: none;
      }

      .settings-dropdown.visible {
        display: block;
      }

      .settings-section {
        padding: 8px;
        border-bottom: 1px solid #E6E7E8;
      }

      .settings-section:last-child {
        border-bottom: none;
      }

      .settings-section-title {
        color: #666;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        margin-bottom: 8px;
      }

      .download-button, .bug-report-link {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 6px 8px;
        border: none;
        background: none;
        color: #333;
        font-size: 14px;
        text-align: left;
        cursor: pointer;
        text-decoration: none;
        border-radius: 4px;
      }

      .download-button:hover, .bug-report-link:hover {
        background-color: #f5f5f5;
      }

      .download-button svg, .bug-report-link svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      /* Utility classes */
      .hidden {
        display: none;
      }

      /* Custom rules textarea */
      #textarea-container {
        margin-top: 10px;
      }
      textarea {
        width: 100%;
        height: 200px;
        font-size: 14px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        padding: 8px;
        border: 1px solid #C7D0D4;
        border-radius: 4px;
      }
      textarea:focus {
        outline: none;
        border-color: #9B51E0;
      }
      /* Context menu styles */
      .context-menu {
        position: fixed;
        background: white;
        border: 1px solid #C7D0D4;
        border-radius: 6px;
        padding: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        font-size: 14px;
      }

      .context-menu-item {
        padding: 6px 12px;
        cursor: pointer;
        border-radius: 4px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .context-menu-item:hover {
        background-color: #f5f5f5;
      }

      .component-usage {
        color: #7B858A;
        font-size: 14px;
        margin-left: 8px;
        cursor: pointer;
        padding: 2px 8px;
        border-radius: 4px;
      }

      .component-usage:hover {
        background: #F3DAF4;
        color: #37006E;
      }
    </style>
  </head>
  <body>
    <!-- Context menu -->
    <div id="context-menu" class="context-menu" style="display: none;">
      <div class="context-menu-item" id="apply-to-all">
        Apply to all components
      </div>
    </div>
    <!-- Component count and settings row -->
    <div class="component-count-row">
      <span id="component-count">0 components need checking</span>
      <span class="build-number">Build: 2025-04-17.1</span>
      <button class="settings-button" id="settings-button" title="Settings">
        <svg viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 2a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 4.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 4.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"/>
        </svg>
      </button>
    </div>
    <!-- Filter section (hidden) -->
    <div class="filter-section">
      <input type="text" 
             class="filter-input" 
             placeholder="Filter components..."
             id="component-filter"
             autocomplete="off">
    </div>
    <div id="settings-dropdown" class="settings-dropdown">
        <div class="settings-section">
          <div class="settings-section-title">Data Export</div>
          <button class="download-button" id="download-csv">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 1.5a.5.5 0 01.5.5v6.793l2.146-2.147a.5.5 0 11.708.708l-3 3a.5.5 0 01-.708 0l-3-3a.5.5 0 11.708-.708L7.5 8.793V2a.5.5 0 01.5-.5zM2 12.5a.5.5 0 01.5-.5h11a.5.5 0 010 1h-11a.5.5 0 01-.5-.5z"/>
            </svg>
            Download Component Scores (CSV)
          </button>
          <button class="download-button" id="download-debug">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 1l5 5v9H3V1h5zm-1 2H4v11h8V7H7V3z"/>
            </svg>
            Export Raw Data (JSON)
          </button>
        </div>

        <div class="settings-section">
          <div class="settings-section-title">Help & Support</div>
          <a href="https://github.com/dannyhope/Component-scorecard/issues" 
             class="bug-report-link" 
             target="_blank" 
             rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
              <path fill-rule="evenodd" d="M8 0a8 8 0 100 16A8 8 0 008 0zM1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0z"/>
            </svg>
            View All Issues
          </a>
          <a href="https://github.com/dannyhope/Component-scorecard/issues/new?template=bug_report.md&title=Bug%3A+&labels=bug&body=%23%23+Description%0A%0A%23%23+Steps+to+reproduce%0A1.+%0A2.+%0A3.+%0A%0A%23%23+Expected+behavior%0A%0A%23%23+Actual+behavior%0A%0A%23%23+Additional+context%0A-%20Figma+version%3A+%0A-%20Browser%3A+%0A-%20OS%3A+" 
             class="bug-report-link" 
             target="_blank" 
             rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
              <path fill-rule="evenodd" d="M8 0a8 8 0 100 16A8 8 0 008 0zM1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0z"/>
            </svg>
            Report a Bug
          </a>
        </div>
      </div>
    </div>

    <!-- Components List -->
    <div id="component-list"></div>

    <!-- Text area for custom checkboxes -->
    <div id="textarea-container">
      <div class="custom-heading">Define your checklist</div>
      <textarea id="custom-rules"></textarea>
    </div>

    <script>
      // Debug info in the UI
      console.log('Plugin UI initializing - Build 2025-04-17.1');
      
      // Add error handling to catch and log JavaScript errors
      window.onerror = function(message, source, lineno, colno, error) {
        console.error(`Error: ${message} at ${source}:${lineno}:${colno}`, error);
        
        // Display error in UI for debugging
        const errorDiv = document.createElement('div');
        errorDiv.style.color = 'red';
        errorDiv.style.padding = '8px';
        errorDiv.style.margin = '8px';
        errorDiv.style.border = '1px solid red';
        errorDiv.style.borderRadius = '4px';
        errorDiv.style.backgroundColor = '#FEE';
        errorDiv.innerHTML = `<strong>Error:</strong> ${message}<br>Check console for details`;
        document.body.prepend(errorDiv);
        return false;
      };
      // Default rules variable kept for reference but not used directly
      const defaultRules = `Component Standards
- [ ] Uses auto layout where appropriate
- [ ] Spaces are variables
- [ ] Any text uses text styles
- [ ] Fills and strokes are styles or variables
- [ ] WCAG2 AA contrast`;

      // Set the default content in the textarea with proper category heading
      const defaultRulesWithCategory = `Component Standards
- [ ] Uses auto layout where appropriate
- [ ] Spaces are variables
- [ ] Any text uses text styles
- [ ] Fills and strokes are styles or variables
- [ ] WCAG2 AA contrast`;
      
      document.getElementById('custom-rules').value = defaultRulesWithCategory;

      // Function to parse rules from the textarea
      function parseRules(text) {
        console.log('Parsing rules from text:', text);
        const lines = text.split('\n');
        let currentCategory = 'Default Category'; // Provide a fallback category
        const rules = {};
        let totalRules = 0;
        
        // Initialize the default category
        rules[currentCategory] = [];

        lines.forEach(line => {
          const trimmedLine = line.trim();
          if (trimmedLine.startsWith('- [ ]')) {
            // It's a checkbox item
            const ruleText = trimmedLine.substring(6).trim(); // Extract the rule text after "- [ ]"
            if (currentCategory) {
              rules[currentCategory] = rules[currentCategory] || [];
              rules[currentCategory].push(ruleText);
              totalRules++;
            }
          } else if (trimmedLine !== '') {
            // It's a heading - keep the full category name including any commas
            currentCategory = trimmedLine;
            rules[currentCategory] = [];
          }
        } catch(error) {
          console.error('Error processing message:', error);
        }
      });

        rules._totalRules = totalRules; // Store total count
        console.log('Parsed rules:', rules);
        return rules;
      }

      // Initialize global state
      let checkboxStates = {};
      const componentState = {};
      let lastAutoExpandedId = null; // Track which component was last auto-expanded
      let allComponents = []; // Store all components for filtering

      // Update component count in UI
      function updateComponentCount() {
        const componentsNeedingCheck = allComponents.filter(component => {
          return component.checkedCount < component.totalCategories;
        } catch(error) {
          console.error('Error processing message:', error);
        }
      });
        const count = componentsNeedingCheck.length;
        const countText = `${count} component${count !== 1 ? 's' : ''} need${count !== 1 ? '' : 's'} checking`;
        document.getElementById('component-count').textContent = countText;
      }

      // Function to filter components
      function filterComponents(searchText) {
        const componentList = document.getElementById('component-list');
        const sections = componentList.getElementsByClassName('component-section');
        
        searchText = searchText.toLowerCase();
        
        for (const section of sections) {
          const componentName = section.querySelector('.component-name').textContent.toLowerCase();
          if (componentName.includes(searchText)) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        }
      }

      // Set up filter input handler
      document.getElementById('component-filter').addEventListener('input', (e) => {
        filterComponents(e.target.value);
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Set up settings button handler
      document.getElementById('settings-button').addEventListener('click', (e) => {
        e.stopPropagation();
        const dropdown = document.getElementById('settings-dropdown');
        dropdown.classList.toggle('visible');
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        const dropdown = document.getElementById('settings-dropdown');
        const settingsButton = document.getElementById('settings-button');
        if (!dropdown.contains(e.target) && !settingsButton.contains(e.target)) {
          dropdown.classList.remove('visible');
        }
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Set up back button handler
      // document.getElementById('back-button').addEventListener('click', () => {
      //   document.getElementById('settings-page').classList.add('hidden');
      // });

      // Helper function to format date for filename
      function formatDateForFilename(date) {
        const pad = (n) => n.toString().padStart(2, '0');
        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}-${pad(date.getMinutes())}`;
      }

      // Helper function to sanitize filename
      function sanitizeFilename(name) {
        // Replace characters that are problematic in various filesystems
        // Windows: \ / : * ? " < > |
        // macOS: : /
        // Linux: /
        const sanitized = name
          .replace(/[\\/:\*\?"<>\|]/g, '-') // Replace Windows/Unix invalid chars
          .replace(/\s+/g, ' ')               // Collapse multiple spaces
          .trim();                           // Remove leading/trailing spaces
        
        return sanitized;
      }

      // Function to download data as JSON file
      function downloadJson(data, filename) {
        const json = JSON.stringify(data, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        
        link.setAttribute('href', url);
        link.setAttribute('download', filename);
        link.style.visibility = 'hidden';
        
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      }

      // Function to properly escape a field for CSV
      function escapeCSVField(field) {
        // Convert to string and handle null/undefined
        const str = field?.toString() || '';
        // If the field contains quotes, commas, or newlines, it needs to be quoted
        if (str.includes('"') || str.includes(',') || str.includes('\n')) {
          // Escape quotes by doubling them and wrap in quotes
          return `"${str.replace(/"/g, '""')}"`;
        }
        // If no special characters, return as is
        return str;
      }

      // Set up debug data download handler
      document.getElementById('download-debug').addEventListener('click', () => {
        const dateStr = formatDateForFilename(new Date());
        const filename = `component-scorecard-data-${dateStr}.json`;
        
        // Get all scoring criteria from the first component section
        const firstComponent = document.querySelector('.component-section');
        const categories = [];
        
        if (firstComponent) {
          firstComponent.querySelectorAll('.category-title').forEach(categoryTitle => {
            const category = categoryTitle.textContent;
            const checkboxGroup = categoryTitle.closest('.checkbox-group');
            const rules = [];
            
            checkboxGroup.querySelectorAll('.checkbox-label').forEach(label => {
              const checkbox = label.querySelector('input[type="checkbox"]');
              rules.push({
                rule: checkbox.getAttribute('data-rule'),
                id: checkbox.id
              } catch(error) {
          console.error('Error processing message:', error);
        }
      });
            } catch(error) {
          console.error('Error processing message:', error);
        }
      });
            
            categories.push({
              name: category,
              rules: rules
            } catch(error) {
          console.error('Error processing message:', error);
        }
      });
          } catch(error) {
          console.error('Error processing message:', error);
        }
      });
        }
        
        // Export the enhanced data structure
        const debugData = {
          // Raw checkbox states as stored in Figma
          checkboxStates,
          
          // Scoring criteria structure
          scoringCriteria: categories,
          
          // Component data with detailed scoring
          components: allComponents.map(comp => {
            // Get all scores for this component
            const scores = {};
            categories.forEach(category => {
              scores[category.name] = {
                categoryName: category.name,
                rules: category.rules.map(rule => ({
                  rule: rule.rule,
                  checked: checkboxStates[comp.id]?.[category.name]?.[rule.rule]?.checked === true,
                  lastModified: checkboxStates[comp.id]?.[category.name]?.[rule.rule]?.timestamp
                }))
              };
            } catch(error) {
          console.error('Error processing message:', error);
        }
      });
            
            return {
              id: comp.id,
              name: comp.name,
              usageCount: comp.usageCount,
              checkedCount: comp.checkedCount,
              totalCategories: comp.totalCategories,
              scores: scores
            };
          })
        };
        
        downloadJson(debugData, filename);
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Set up CSV download handler
      document.getElementById('download-csv').addEventListener('click', () => {
        // Get all checkboxes from the first component section (they all have the same structure)
        const firstComponent = document.querySelector('.component-section');
        if (!firstComponent) return; // No components to export

        const columns = [];
        
        // Get all category titles and their associated checkboxes
        firstComponent.querySelectorAll('.category-title').forEach(categoryTitle => {
          const category = categoryTitle.textContent;
          const checkboxGroup = categoryTitle.closest('.checkbox-group');
          
          // Get all checkboxes in this category
          checkboxGroup.querySelectorAll('.checkbox-label').forEach(label => {
            const checkbox = label.querySelector('input[type="checkbox"]');
            const ruleText = checkbox.getAttribute('data-rule');
            
            columns.push({
              // Create properly escaped header
              header: escapeCSVField(`${category} - ${ruleText}`),
              category: category,
              rule: ruleText,
              // Store the actual checkbox element for state verification
              checkbox: checkbox
            } catch(error) {
          console.error('Error processing message:', error);
        }
      });
          } catch(error) {
          console.error('Error processing message:', error);
        }
      });
        } catch(error) {
          console.error('Error processing message:', error);
        }
      });

        // Create header row with escaped fields
        const headers = [
          escapeCSVField('Component Name'),
          escapeCSVField('Usage Count'),
          ...columns.map(col => col.header)
        ];
        const csvRows = [headers.join(',')];
        
        // Add a row for each component
        allComponents.forEach(component => {
          const row = [];
          
          // Add component name (properly escaped)
          row.push(escapeCSVField(component.name));
          
          // Add usage count
          row.push(escapeCSVField(component.usageCount));
          
          // Add checkmark symbols for each scoring criteria
          columns.forEach(({category, rule, checkbox}) => {
            // First check the actual checkbox state in the UI
            const uiChecked = checkbox.checked;
            // Then verify against stored state
            const storedState = checkboxStates[component.id]?.[category]?.[rule];
            // Use a checkmark if either the UI or stored state shows it's checked
            const isChecked = uiChecked || storedState?.checked === true;
            row.push(escapeCSVField(isChecked ? '✓' : ''));
          } catch(error) {
          console.error('Error processing message:', error);
        }
      });
          
          csvRows.push(row.join(','));
        } catch(error) {
          console.error('Error processing message:', error);
        }
      });

        // Create CSV content with UTF-8 BOM for Excel compatibility
        const csvContent = '\ufeff' + csvRows.join('\n');
        
        // Get document title from Figma for the filename
        parent.postMessage({
          pluginMessage: { type: 'get-document-title' }
        }, '*');

        // Listen for the response with the document title
        const messageHandler = (event) => {
          if (event.data.pluginMessage && event.data.pluginMessage.type === 'document-title') {
            const docTitle = event.data.pluginMessage.title;
            const dateStr = formatDateForFilename(new Date());
            const filename = `${sanitizeFilename(docTitle)} component scorecards (${dateStr}).csv`;

            // Create and trigger download
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            
            link.setAttribute('href', url);
            link.setAttribute('download', filename);
            link.style.visibility = 'hidden';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url); // Clean up the URL object

            // Clean up the event listener
            window.removeEventListener('message', messageHandler);
          }
        };

        window.addEventListener('message', messageHandler);
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Function to handle component selection in the UI
      function highlightComponentInUI(componentId) {
        // Remove previous selection
        document.querySelectorAll('.component-section').forEach(section => {
          section.classList.remove('selected');
        } catch(error) {
          console.error('Error processing message:', error);
        }
      });

        // If no component is selected (componentId is null), just clear selection
        if (!componentId) {
          // Close the last auto-expanded component if it wasn't user-toggled
          if (lastAutoExpandedId && !componentState[lastAutoExpandedId].userToggled && !componentState[lastAutoExpandedId].collapsed) {
            componentState[lastAutoExpandedId].collapsed = true;
            toggleComponentVisibilityInUI(lastAutoExpandedId);
          }
          lastAutoExpandedId = null;
          return;
        }

        // Find and highlight the selected component
        const section = document.querySelector(`[data-id="${componentId}"]`);
        if (section) {
          section.classList.add('selected');

          // Close the last auto-expanded component if it wasn't user-toggled
          if (lastAutoExpandedId && lastAutoExpandedId !== componentId && 
              !componentState[lastAutoExpandedId].userToggled && 
              !componentState[lastAutoExpandedId].collapsed) {
            componentState[lastAutoExpandedId].collapsed = true;
            toggleComponentVisibilityInUI(lastAutoExpandedId);
          }

          // Expand the newly selected component if it's collapsed
          if (componentState[componentId].collapsed) {
            componentState[componentId].collapsed = false;
            componentState[componentId].userToggled = false; // Mark as auto-expanded
            toggleComponentVisibilityInUI(componentId);
            lastAutoExpandedId = componentId;
          }

          // Scroll the component into view
          section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }

      // Listen for messages from the plugin code
      window.onmessage = async (event) => {
        console.log('Message received:', event.data.pluginMessage);
        try {
        const message = event.data.pluginMessage;

        if (message.type === 'component-selected') {
          highlightComponentInUI(message.componentId);
        } else if (message.type === 'load-components') {
          const componentList = document.getElementById('component-list');
          componentList.innerHTML = ''; // Clear existing list

          const checkboxStates = message.checkboxStates;

          let components = message.components;
          allComponents = components;
          updateComponentCount();

          // Get the custom rules from the textarea and parse them
          // Get the custom rules from the textarea and parse them
          const rulesText = document.getElementById('custom-rules').value;
          console.log('Rules text from textarea:', rulesText);
          const rules = parseRules(rulesText);
          const totalRules = rules._totalRules;

          // Add totalCategories to each component
          components = components.map(component => ({
            ...component,
            totalCategories: totalRules
          }));

          components.forEach((component, index) => {
            const section = document.createElement('div');
            section.className = 'component-section';
            section.setAttribute('data-id', component.id);

            // Collapsed state toggle
            componentState[component.id] = { 
              collapsed: index !== 0, // First component is expanded, others collapsed
              userToggled: false // Track if the user manually toggled this component
            };

            // Colour code scores
            const scorePercent = (component.checkedCount / component.totalCategories) * 100;
            let scoreClass = '';
            if (scorePercent <= 33) scoreClass = 'score-red';
            else if (scorePercent <= 66) scoreClass = 'score-amber';
            else scoreClass = 'score-green';

            // Create title container
            const title = document.createElement('div');
            title.className = `component-title`; // Title stays purple
            title.id = `component-title-${component.id}`;

            // Function to escape HTML
            function escapeHtml(unsafe) {
              return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
            }

            // Create expand/collapse arrow
            const expandArrow = document.createElement('span');
            expandArrow.className = 'component-expand';
            expandArrow.textContent = '▼';
            expandArrow.style.transform = componentState[component.id].collapsed ? 'rotate(-90deg)' : 'rotate(0)';
            expandArrow.style.transition = 'transform 0.2s ease';

            // Create component icon
            const componentIcon = document.createElement('span');
            componentIcon.className = 'component-icon';
            componentIcon.textContent = '❖';
            componentIcon.style.color = '#7C3DDD';
            componentIcon.style.marginRight = '4px';

            // Create component name element
            const nameSpan = document.createElement('span');
            nameSpan.className = 'component-name';
            const lastModifiedDate = component.lastModified ? new Date(component.lastModified) : null;
            
            // Find the least recent checkbox timestamp
            let leastRecentCheckDate = null;
            if (checkboxStates[component.id]) {
              const timestamps = Object.values(checkboxStates[component.id])
                .flatMap(category => Object.values(category))
                .filter(state => state.checked && state.timestamp)
                .map(state => new Date(state.timestamp));
              if (timestamps.length > 0) {
                leastRecentCheckDate = new Date(Math.min(...timestamps));
              }
            }
            
            // Show red dot if component was modified more recently than least recent check
            const showModifiedIndicator = lastModifiedDate && leastRecentCheckDate && 
              lastModifiedDate > leastRecentCheckDate;
            
            const modifiedDot = showModifiedIndicator ? '<span class="modified-indicator"></span>' : '';
            const formattedModifiedDate = lastModifiedDate ? formatDate(lastModifiedDate) : 'never';
            
            nameSpan.innerHTML = `${modifiedDot}${escapeHtml(component.name)} <span class="${scoreClass}">(${component.checkedCount}/${component.totalCategories})</span> <span class="last-modified" data-modified="${formattedModifiedDate}">edited ${formattedModifiedDate}</span> <span class="component-usage" onclick="selectInstances('${component.id}')" title="Click to select all instances">${component.usageCount} ${component.usageCount === 1 ? 'instance' : 'instances'}</span>`;

            // Add elements to title
            title.appendChild(expandArrow);
            title.appendChild(componentIcon);
            title.appendChild(nameSpan);
            section.appendChild(title);

            // Click title to toggle collapse and select in Figma
            title.onclick = () => {
              // Toggle collapse state
              componentState[component.id].collapsed = !componentState[component.id].collapsed;
              componentState[component.id].userToggled = true; // Mark as user-toggled
              expandArrow.style.transform = componentState[component.id].collapsed ? 'rotate(-90deg)' : 'rotate(0)';
              toggleComponentVisibilityInUI(component.id);

              // Select in Figma
              parent.postMessage({ 
                pluginMessage: { 
                  type: 'select-component-in-figma',
                  componentId: component.id 
                }
              }, '*');
            };

            // Create the component rules container (not to be confused with individual category groups)
            const componentRules = document.createElement('div');
            componentRules.className = componentState[component.id].collapsed ? 'component-rules hidden' : 'component-rules';

            // Populate checkboxes based on the parsed rules
            for (let category in rules) {
              if (category === '_totalRules') continue; // Skip our internal property
              const group = document.createElement('div');
              group.className = 'category-group';

              const categoryTitle = document.createElement('div');
              categoryTitle.className = 'category-title';
              categoryTitle.textContent = category;
              group.appendChild(categoryTitle);

              rules[category].forEach(ruleText => {
                const checkboxLabel = document.createElement('label');
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';

                // Set checkbox state from saved state
                checkbox.checked = checkboxStates[component.id]
                  && checkboxStates[component.id][category]
                  && checkboxStates[component.id][category][ruleText]
                  && checkboxStates[component.id][category][ruleText].checked || false;

                // Add data attributes for finding the checkbox later
                checkbox.setAttribute('data-category', category);
                checkbox.setAttribute('data-rule', ruleText);
                
                checkbox.onchange = () => {
                  const timestamp = checkbox.checked ? new Date() : null;
                  if (checkbox.checked) {
                    const timestampSpan = checkboxLabel.querySelector('.checkbox-timestamp');
                    if (timestampSpan) {
                      timestampSpan.textContent = formatDate(timestamp);
                    }
                  } else {
                    const timestampSpan = checkboxLabel.querySelector('.checkbox-timestamp');
                    if (timestampSpan) {
                      timestampSpan.textContent = '';
                    }
                  }
                  parent.postMessage({ pluginMessage: { type: 'ok-checkbox-changed', componentId: component.id, category: category, label: ruleText, isChecked: checkbox.checked } }, '*');
                  
                  // Update modification indicator after checkbox change
                  setTimeout(() => updateModificationIndicator(component.id), 100); // Small delay to ensure state is updated
                };

                checkboxLabel.className = 'checkbox-label';
                checkboxLabel.appendChild(checkbox);
                
                const textSpan = document.createElement('span');
                textSpan.textContent = ruleText;
                checkboxLabel.appendChild(textSpan);

                // Add timestamp span
                const timestampSpan = document.createElement('span');
                timestampSpan.className = 'checkbox-timestamp';
                
                // Set initial timestamp if exists
                const state = checkboxStates[component.id]?.[category]?.[ruleText];
                if (state?.checked && state?.timestamp) {
                    const date = new Date(state.timestamp);
                    timestampSpan.textContent = formatDate(date);
                }
                checkboxLabel.appendChild(timestampSpan);
                
                // Add right-click handler to the label
                checkboxLabel.addEventListener('contextmenu', (e) => {
                  e.preventDefault();
                  const menu = document.getElementById('context-menu');
                  menu.style.display = 'block';
                  menu.style.left = `${e.pageX}px`;
                  menu.style.top = `${e.pageY}px`;
                  
                  // Store the clicked item's info for the context menu
                  menu.dataset.category = category;
                  menu.dataset.ruleText = ruleText;
                } catch(error) {
          console.error('Error processing message:', error);
        }
      });
                
                group.appendChild(checkboxLabel);
              } catch(error) {
          console.error('Error processing message:', error);
        }
      });

              componentRules.appendChild(group);
            }

            section.appendChild(componentRules);
            componentList.appendChild(section);
          } catch(error) {
          console.error('Error processing message:', error);
        }
      });
        }

        // Handle dynamic score updates when checkboxes are ticked/unticked
        if (message.type === 'update-score') {
          // Update the component's checked count in our local state
          const component = allComponents.find(c => c.id === message.componentId);
          if (component) {
            component.checkedCount = message.checkedCount;
            component.totalCategories = message.totalRules;
            updateScore(message.componentId, message.checkedCount);
            updateComponentCount(); // Refresh the component count
          }
        }
      };

      // Handle context menu actions
      document.getElementById('apply-to-all').addEventListener('click', () => {
        const menu = document.getElementById('context-menu');
        const category = menu.dataset.category;
        const ruleText = menu.dataset.ruleText;

        // Apply to all components
        const now = new Date();
        allComponents.forEach(component => {
          // Update the UI checkbox
          const componentSection = document.querySelector(`[data-id="${component.id}"]`);
          if (componentSection) {
            const checkbox = componentSection.querySelector(`input[type="checkbox"][data-category="${category}"][data-rule="${ruleText}"]`);
            if (checkbox) {
              checkbox.checked = true;
              // Update timestamp
              const label = checkbox.closest('.checkbox-label');
              if (label) {
                const timestampSpan = label.querySelector('.checkbox-timestamp');
                if (timestampSpan) {
                  timestampSpan.textContent = formatDate(now);
                }
              }
            }
          }

          // Send message to update the plugin state
          parent.postMessage({
            pluginMessage: {
              type: 'ok-checkbox-changed',
              componentId: component.id,
              category: category,
              label: ruleText,
              isChecked: true,
              applyToAll: true,
              timestamp: now.toISOString()
            }
          }, '*');
          
          // Update modification indicator after applying to all
          setTimeout(() => updateModificationIndicator(component.id), 100); // Small delay to ensure state is updated
        } catch(error) {
          console.error('Error processing message:', error);
        }
      });

        // Hide the menu
        menu.style.display = 'none';
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Hide context menu when clicking outside
      document.addEventListener('click', (e) => {
        const menu = document.getElementById('context-menu');
        if (!menu.contains(e.target)) {
          menu.style.display = 'none';
        }
      } catch(error) {
          console.error('Error processing message:', error);
        }
      });

      // Function to toggle the collapsed state of a component
      function toggleComponentVisibilityInUI(componentId) {
        const componentEl = document.querySelector(`[data-id="${componentId}"]`);
        const componentRules = componentEl.querySelector('.component-rules');
        
        if (componentState[componentId].collapsed) {
          componentRules.classList.add('hidden');
        } else {
          componentRules.classList.remove('hidden');
        }
      }

      // Function to format date in a friendly way
      function formatDate(date) {
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMins / 60);
        const diffDays = Math.floor(diffHours / 24);

        if (diffMins < 1) return 'just now';
        if (diffMins < 60) return `${diffMins}m ago`;
        if (diffHours < 24) return `${diffHours}h ago`;
        if (diffDays < 7) return `${diffDays}d ago`;

        return date.toLocaleDateString();
      }

      // Function to check if component needs modification indicator
      function updateModificationIndicator(componentId) {
        const component = allComponents.find(c => c.id === componentId);
        if (!component) return;

        const lastModifiedDate = component.lastModified ? new Date(component.lastModified) : null;
        
        // Find the least recent checkbox timestamp
        let leastRecentCheckDate = null;
        if (checkboxStates[componentId]) {
          const timestamps = Object.values(checkboxStates[componentId])
            .flatMap(category => Object.values(category))
            .filter(state => state.checked && state.timestamp)
            .map(state => new Date(state.timestamp));
          if (timestamps.length > 0) {
            leastRecentCheckDate = new Date(Math.min(...timestamps));
          }
        }
        
        // Show red dot if component was modified more recently than least recent check
        const showModifiedIndicator = lastModifiedDate && leastRecentCheckDate && 
          lastModifiedDate > leastRecentCheckDate;

        // Update the UI
        const componentSection = document.querySelector(`[data-id="${componentId}"]`);
        if (componentSection) {
          const existingDot = componentSection.querySelector('.modified-indicator');
          const nameSpan = componentSection.querySelector('.component-name');
          
          if (showModifiedIndicator && !existingDot) {
            const dot = document.createElement('span');
            dot.className = 'modified-indicator';
            nameSpan.insertBefore(dot, nameSpan.firstChild);
          } else if (!showModifiedIndicator && existingDot) {
            existingDot.remove();
          }
        }
      }

      // Function to dynamically update score and score colour
      function updateScore(componentId, checkedCount) {
        // Find the component in our stored array to get its total
        const component = allComponents.find(c => c.id === componentId);
        if (!component) return;

        // Update the component's checked count
        component.checkedCount = checkedCount;

        const scorePercent = (checkedCount / component.totalCategories) * 100;
        let scoreClass = '';
        if (scorePercent <= 33) scoreClass = 'score-red';
        else if (scorePercent <= 66) scoreClass = 'score-amber';
        else scoreClass = 'score-green';

        const nameSpan = document.querySelector(`[data-id="${componentId}"] .component-name`);
        if (nameSpan) {
          // Get all the elements after the score span
          const elements = nameSpan.innerHTML.split('</span>');
          const modifiedIndicator = elements[0].includes('modified-indicator') ? elements[0] + '</span>' : '';
          const lastModified = elements[2] ? elements[2] + '</span>' : '';
          const usageCount = elements[3] ? elements[3] + '</span>' : '';
          
          // Update with new score but preserve other elements
          nameSpan.innerHTML = `${modifiedIndicator}${component.name} <span class="${scoreClass}">(${checkedCount}/${component.totalCategories})</span>${lastModified}${usageCount}`;
        }

        // Update component count since the checked status changed
        updateComponentCount();
      }

      function selectInstances(componentId) {
        parent.postMessage({ 
          pluginMessage: { 
            type: 'select-instances',
            componentId: componentId
          }
        }, '*');
      }
    </script>
  </body>
</html>