{
  "name": "component-scorecard",
  "version": "2.0.0",
  "description": "Score design-system components against a checklist in Figma",
  "author": "Danny Hope",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://dannyhope.co.uk/component-scorecard",
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "scripts/ensure-local-domain.sh && build-figma-plugin --typecheck --watch",
    "build:pack": "build-figma-plugin --typecheck --minify --output publish/plugin",
    "start:check": "scripts/ensure-local-domain.sh"
  },
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.134.0",
    "typescript": "^5.9.2"
  },
  "figma-plugin": {
    "id": "1494664241767135067",
    "name": "Component scorecard",
    "editorType": [
      "figma"
    ],
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ]
    }
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
